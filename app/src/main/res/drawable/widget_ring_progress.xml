<?xml version="1.0" encoding="utf-8"?>
<!-- Circular progress ring (blue) for the static widget preview.
     Used as the progressDrawable of a determinate ProgressBar; the ring with
     useLevel="true" draws the arc proportional to the progress level. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:shape="ring"
            android:innerRadiusRatio="2.6"
            android:thicknessRatio="12.5"
            android:useLevel="false">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape
                android:shape="ring"
                android:innerRadiusRatio="2.6"
                android:thicknessRatio="12.5"
                android:useLevel="true">
                <solid android:color="#FF34AADC" />
            </shape>
        </rotate>
    </item>
</layer-list>
