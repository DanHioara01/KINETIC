# Enhanced Dockerfile for Backend with Persistent Database Storage
FROM node:20-slim

# Create app directory
WORKDIR /app

# Install dependencies for runtime utilities
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Copy package files and install dependencies
COPY backend/package*.json ./
RUN npm install --production

# Copy source code
COPY backend/index.js .

# Create necessary directories
RUN mkdir -p logs shared-data

# Set proper ownership and permissions
RUN chown -R node:node . && chmod -R 755 . && touch logs/server.log

# Expose port
EXPOSE 4242

# Health check configuration file
COPY docker/health.json ./

# Enhanced entry point with health monitoring
COPY docker/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# Add startup script for database persistence
COPY docker/start.sh ./start.sh
RUN chmod +x ./start.sh

USER node

# Default command
CMD ["/app/entrypoint.sh"]